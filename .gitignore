# ── Terraform ──────────────────────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Build artifacts (generated by scripts/build_lambda.sh) ─────────────────
artifacts/
.build/
*.zip

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── AWS Glue local development (Glue Studio downloads) ─────────────────────
glue_local/
.glue_local/

# ── AWS SAM / CDK (not used here, but common in AWS projects) ───────────────
.aws-sam/
cdk.out/

# ── LocalStack (integration tests with USE_LOCALSTACK=1) ───────────────────
.localstack/
localstack_data/
volume/

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.iml

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ── Environment / secrets — NEVER commit these ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials
aws_credentials
